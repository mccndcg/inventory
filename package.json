{
  "name": "my-remix-app",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "packageManager": "npm@11.12.1",
  "scripts": {
    "audit:all": "npm audit --audit-level=low",
    "audit:prod": "npm audit --omit=dev --audit-level=low",
    "build": "react-router build && node scripts/build-offline-worker.mjs",
    "build:sync": "node scripts/build-sync-server.mjs && node scripts/verify-sync-bundle.mjs",
    "backup:sync": "node build/sync-backup.mjs",
    "dev": "react-router dev",
    "lint": "eslint --no-cache --max-warnings 0 .",
    "preview": "vite preview",
    "scan:secrets": "node scripts/secret-scan.mjs",
    "start": "node scripts/serve-static.mjs",
    "start:sync": "node build/sync-server.mjs",
    "test": "vitest run",
    "test:offline": "playwright test",
    "test:sync": "vitest run server",
    "test:watch": "vitest",
    "typecheck": "tsc",
    "verify:release": "node scripts/verify-release-record.mjs",
    "verify:staging": "node scripts/verify-staging.mjs"
  },
  "resolutions": {
    "@radix-ui/react-focus-scope": "1.1.2"
  },
  "overrides": {
    "tar": "7.5.22"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-accordion": "^1.2.3",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.7",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-popover": "^1.1.5",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@react-router/node": "8.3.0",
    "@tanstack/react-table": "^8.21.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "dexie": "^4.0.11",
    "dexie-react-hooks": "^1.1.7",
    "fastify": "^5.10.0",
    "isbot": "^5.2.1",
    "jotai": "^2.12.2",
    "lucide-react": "^0.473.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "^7.54.2",
    "react-hot-toast": "^2.5.1",
    "react-router": "8.3.0",
    "recharts": "^2.15.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@eslint/js": "10.0.1",
    "@react-router/dev": "8.3.0",
    "@react-router/fs-routes": "8.3.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "autoprefixer": "^10.4.19",
    "esbuild": "0.28.1",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.8.0",
    "jsdom": "^30.0.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=11.12.1 <12"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.15.0 <25",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=11.12.1 <12",
      "onFail": "error"
    }
  }
}
